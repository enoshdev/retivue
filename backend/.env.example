# RETIVUE Clinical Backend - Environment Variables Example
PROJECT_NAME="RETIVUE Clinical Backend"
APP_ENV="development"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_USER="retivue_user"
POSTGRES_PASSWORD="your-strong-development-password"
POSTGRES_DB="retivue"

# Connection Strings
DATABASE_URL="postgresql+asyncpg://retivue_user:your-strong-development-password@127.0.0.1:5433/retivue"
SYNC_DATABASE_URL="postgresql+psycopg://retivue_user:your-strong-development-password@127.0.0.1:5433/retivue"

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# Frontend & CORS Configuration
FRONTEND_ORIGIN="http://localhost:3000"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secure Image Storage & Upload Limits (Phase 4)
STORAGE_PROVIDER="local"
# Optional override; defaults outside project directory in OS local app data
# LOCAL_STORAGE_ROOT="/var/lib/retivue/private_storage"
MAX_UPLOAD_SIZE_BYTES=20971520
MIN_IMAGE_WIDTH=128
MIN_IMAGE_HEIGHT=128
MAX_IMAGE_PIXELS=40000000

# Phase 5 Research Datasets Directory (outside Git & OneDrive)
# DATASET_ROOT="/var/lib/retivue/datasets"

# Phase 9 Model Experiments & Checkpoints Directory (outside Git & OneDrive)
# MODEL_ROOT="/var/lib/retivue/models"
